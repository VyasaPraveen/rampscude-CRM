rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The CRM keeps one document per module under `workspace/{moduleKey}`.
    // Clients sign in anonymously, so an authenticated session is required.
    //
    // NOTE: this is a shared demo workspace — any signed-in (anonymous) client can
    // read and write it. When the CRM moves to the client's own server, replace this
    // with per-user auth and role checks before real business data goes in.
    match /workspace/{moduleKey} {
      allow read, write: if request.auth != null;
    }

    // Nothing else is reachable.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
